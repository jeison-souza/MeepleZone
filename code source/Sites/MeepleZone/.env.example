# Copier ce fichier en .env et adapter la valeur à la machine hôte.
# Racine des dossiers Docker; l'application publiée est lue dans $DOCKERDIR/MeepleZone/App
DOCKERDIR=/volume1/docker

# Connexion Microsoft (inscription d'application dans Microsoft Entra ID).
# Ne jamais mettre les vraies valeurs dans ce fichier : elles vont seulement dans le .env (ignoré par git).
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=remplacer-par-la-valeur-du-secret

# Connexion Google (facultatif tant que l'application n'est pas inscrite dans Google Cloud).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
