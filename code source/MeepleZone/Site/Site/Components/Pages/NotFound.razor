@page "/not-found"
@layout MainLayout

<PageTitle>MeepleZone - Page introuvable</PageTitle>

<PageErreur Code="404"
            Pret="Pret"
            Image="@Scenario.Image"
            Alt="@Scenario.Alt"
            Titre="@Scenario.Titre"
            Phrase="@Scenario.Phrase"
            Bouton="@Scenario.Bouton"
            ClasseImage="@Scenario.Classe"
            Legende="@Scenario.Legende" />

@code {
    private sealed record Illustration(string Image, string Alt, string Titre, string Phrase, string Bouton, string Classe = "", string? Legende = null);

    // Chaque illustration a ses propres textes : le dessin et la phrase racontent la même histoire.
    private static readonly Illustration[] Illustrations =
    [
        new("images/404-etagere.svg",
            "Un meeple cherche avec une loupe, dans une étagère de jeux, la boîte qui manque.",
            "Une boîte manque à l'appel",
            "Même avec une loupe, la page que vous cherchez reste introuvable.",
            "Retour à l'accueil"),
        new("images/404-meeple-panique.svg",
            "Un meeple en panique, les yeux grands ouverts, en sueur.",
            "Hors du plateau !",
            "La page que vous cherchez a quitté la partie.",
            "Retour à la case départ",
            "mz-erreur-image--rogne"),
        new("images/404-meeple-triste.svg",
            "Un meeple triste, les yeux embués, tout seul.",
            "Cette page nous a fait faux bond",
            "La page que vous cherchez est introuvable, et le meeple en a gros sur le cœur.",
            "Retour à l'accueil",
            Legende: "Sniff…"),
    ];

    [Inject] private IWebHostEnvironment Environment { get; set; } = default!;

    /// <summary>En développement seulement : <c>?cenario=2</c> montre le deuxième scénario.</summary>
    [SupplyParameterFromQuery(Name = "cenario")]
    public int? CenarioDemande { get; set; }

    private int _choix = -1;

    private bool Pret => _choix >= 0;

    private Illustration Scenario => Illustrations[Math.Max(_choix, 0)];

    // La page est d'abord rendue sur le serveur (prérendu), puis une seconde fois quand la connexion interactive
    // s'ouvre. Tirer au hasard dans ces deux rendus ferait changer l'illustration après le chargement.
    // OnAfterRender ne s'exécute pas pendant le prérendu : le tirage se fait donc une seule fois, côté interactif.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            var demande = Environment.IsDevelopment() && CenarioDemande is >= 1 && CenarioDemande <= Illustrations.Length;
            _choix = demande ? CenarioDemande!.Value - 1 : Random.Shared.Next(Illustrations.Length);
            StateHasChanged();
        }
    }
}
