@page "/connexion-requise"

<PageTitle>MeepleZone - @Titre</PageTitle>

<section class="mz-connexion">
    <MudPaper Elevation="2" Class="mz-connexion-carte">
        <img src="images/logo.svg" alt="" class="mz-connexion-logo" />
        <p class="mz-connexion-marque" aria-hidden="true"><span class="mz-connexion-marque-meeple">Meeple</span><span class="mz-connexion-marque-zone">Zone</span></p>

        <h1 class="mz-connexion-titre">@Titre</h1>

        @if (Etat == EtatConnexion.Annulee)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mz-connexion-alerte">
                La connexion a été annulée. Vous pouvez réessayer quand vous le souhaitez.
            </MudAlert>
        }
        else if (Etat == EtatConnexion.Erreur)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mz-connexion-alerte">
                Un problème est survenu pendant la connexion. Veuillez réessayer; si le problème persiste, essayez l'autre fournisseur.
            </MudAlert>
        }
        else
        {
            <p class="mz-connexion-phrase">Connectez-vous pour accéder à cette page.</p>
        }

        @* Liens simples (navigation complète) : la connexion passe par une redirection vers le fournisseur. *@
        <div class="mz-connexion-boutons">
            <a href="/connexion/Google" class="mz-fournisseur mz-fournisseur-google" data-enhance-nav="false">
                <svg class="mz-fournisseur-icone" viewBox="0 0 48 48" aria-hidden="true">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                </svg>
                <span>Continuer avec Google</span>
            </a>
            <a href="/connexion/Microsoft" class="mz-fournisseur mz-fournisseur-microsoft" data-enhance-nav="false">
                <svg class="mz-fournisseur-icone" viewBox="0 0 21 21" aria-hidden="true">
                    <rect x="1" y="1" width="9" height="9" fill="#F25022" />
                    <rect x="11" y="1" width="9" height="9" fill="#7FBA00" />
                    <rect x="1" y="11" width="9" height="9" fill="#00A4EF" />
                    <rect x="11" y="11" width="9" height="9" fill="#FFB900" />
                </svg>
                <span>Continuer avec Microsoft</span>
            </a>
        </div>

        <p class="mz-connexion-note">Aucun mot de passe à créer : la connexion passe par votre compte Google ou Microsoft.</p>

        <MudLink Href="/" Class="mz-connexion-retour">Retour à l'accueil</MudLink>
    </MudPaper>
</section>

@code {
    private enum EtatConnexion { Requise, Annulee, Erreur }

    [SupplyParameterFromQuery(Name = "motif")]
    public string? Motif { get; set; }

    // Un motif inconnu retombe sur « connexion requise » : la page ne reflète jamais du texte venu de l'adresse.
    private EtatConnexion Etat => Motif?.ToLowerInvariant() switch
    {
        "annulee" => EtatConnexion.Annulee,
        "erreur" => EtatConnexion.Erreur,
        _ => EtatConnexion.Requise
    };

    private string Titre => Etat switch
    {
        EtatConnexion.Annulee => "Connexion annulée",
        EtatConnexion.Erreur => "La connexion a échoué",
        _ => "Connexion requise"
    };
}
