@page "/ma-collection"
@using MeepleZone.Domaines.Collection
@using MeepleZone.Domaines.Collection.Contrats.Enums
@using MeepleZone.Domaines.Collection.Contrats.Modeles
@using MeepleZone.Site.Collection
@using MeepleZone.Site.Components.Collection
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@attribute [Authorize]
@inject IDomaineCollection Domaine
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<MaCollection> Journal

<PageTitle>MeepleZone - Ma collection</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="my-8">
    <div class="mz-collection-entete">
        <div>
            <MudText Typo="Typo.h4" HtmlTag="h1">Ma collection</MudText>
            @if (!chargementInitial && !echec)
            {
                <MudText Typo="Typo.body2" Class="mz-collection-compteur">@LibelleTotal</MudText>
            }
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OuvrirAjoutAsync">Ajouter un jeu</MudButton>
    </div>

    <MudTextField T="string" Value="recherche" ValueChanged="SurChangementRechercheAsync" Label="Rechercher par nom"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true" DebounceInterval="350" Clearable="true" Class="mt-4 mb-2" />

    <div class="mz-collection-filtres-barre">
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList"
                   OnClick="() => panneauOuvert = !panneauOuvert">
            @(filtres.NombreCriteres > 0 ? $"Filtres ({filtres.NombreCriteres})" : "Filtres")
        </MudButton>

        @foreach (var chip in filtres.Chips(nomsModes, nomsMecaniques))
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" OnClose="() => ChangerFiltresAsync(filtres.Sans(chip.Cle))">@chip.Libelle</MudChip>
        }

        @if (filtres.EstActif)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="EffacerFiltresAsync">Effacer les filtres</MudButton>
        }
    </div>

    <MudCollapse Expanded="panneauOuvert" Class="mb-4">
        <PanneauFiltresCollection Filtres="filtres" FiltresChanged="ChangerFiltresAsync" Modes="modes" Mecaniques="mecaniques" />
    </MudCollapse>

    <div class="mb-4"></div>

    @if (echec)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
            La collection n'a pas pu être chargée.
            <MudButton Size="Size.Small" Class="ml-2" OnClick="ChargerAsync">Réessayer</MudButton>
        </MudAlert>
    }
    else if (chargementInitial)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (items.Count == 0 && string.IsNullOrEmpty(recherche) && !filtres.EstActif)
    {
        <MudPaper Elevation="0" Outlined="true" Class="mz-collection-vide">
            <MudIcon Icon="@Icons.Material.Filled.Casino" Size="Size.Large" />
            <MudText Typo="Typo.h6" HtmlTag="h2">Votre collection est vide</MudText>
            <MudText Typo="Typo.body2">Ajoutez votre premier jeu pour commencer à bâtir votre ludothèque.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OuvrirAjoutAsync">Ajouter un jeu</MudButton>
        </MudPaper>
    }
    else if (items.Count == 0)
    {
        <MudText Typo="Typo.body1">
            @(filtres.EstActif
                ? "Aucun jeu de votre collection ne correspond à ces critères."
                : $"Aucun jeu de votre collection ne correspond à « {recherche} ».")
        </MudText>
        @if (filtres.EstActif)
        {
            <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="EffacerFiltresAsync">Effacer les filtres</MudButton>
        }
    }
    else
    {
        <div class="mz-grille-jeux">
            @foreach (var item in items)
            {
                <CarteJeu @key="item.PossessionId" Item="item" OnModifier="ModifierAsync" OnRetirer="RetirerAsync" />
            }
        </div>

        @if (NombrePages > 1)
        {
            <div class="mz-collection-pagination">
                <MudPagination Count="NombrePages" Selected="page" SelectedChanged="ChangerPageAsync" />
            </div>
        }
    }
</MudContainer>

@code {
    private const int TaillePage = 8;

    private IReadOnlyList<ItemCollectionDto> items = [];
    private int total;
    private int page = 1;
    private string? recherche;
    private bool chargementInitial = true;
    private bool echec;

    // Les filtres vivent aussi dans l'adresse (?joueurs=4&note=7) : la page se rouvre telle quelle et le retour arrière fonctionne.
    private FiltresCollection filtres = new();
    private bool panneauOuvert;
    private IReadOnlyList<ModeJeuDto> modes = [];
    private IReadOnlyList<MecaniqueDto> mecaniques = [];
    private IReadOnlyDictionary<Guid, string> nomsModes = new Dictionary<Guid, string>();
    private IReadOnlyDictionary<Guid, string> nomsMecaniques = new Dictionary<Guid, string>();
    private bool premierRendu = true;

    [SupplyParameterFromQuery(Name = FiltresCollection.CleJoueurs)] public string? ParamJoueurs { get; set; }
    [SupplyParameterFromQuery(Name = FiltresCollection.CleOptimal)] public string? ParamOptimal { get; set; }
    [SupplyParameterFromQuery(Name = FiltresCollection.CleDuree)] public string? ParamDuree { get; set; }
    [SupplyParameterFromQuery(Name = FiltresCollection.CleNote)] public string? ParamNote { get; set; }
    [SupplyParameterFromQuery(Name = FiltresCollection.ClePartiesMin)] public string? ParamPartiesMin { get; set; }
    [SupplyParameterFromQuery(Name = FiltresCollection.ClePartiesMax)] public string? ParamPartiesMax { get; set; }
    [SupplyParameterFromQuery(Name = FiltresCollection.CleMode)] public string? ParamMode { get; set; }
    [SupplyParameterFromQuery(Name = FiltresCollection.CleMecaniques)] public string? ParamMecaniques { get; set; }

    private int NombrePages => (int)Math.Ceiling(total / (double)TaillePage);

    private string LibelleTotal => total switch
    {
        0 => "Aucun jeu",
        1 => "1 jeu",
        _ => $"{total} jeux"
    };

    // Appelée à l'ouverture et à chaque changement de l'adresse (y compris ceux que la page provoque elle-même).
    protected override async Task OnParametersSetAsync()
    {
        var depuisAdresse = FiltresCollection.DepuisParametres(
            ParamJoueurs, ParamOptimal, ParamDuree, ParamNote, ParamPartiesMin, ParamPartiesMax, ParamMode, ParamMecaniques);

        if (premierRendu)
        {
            premierRendu = false;
            filtres = depuisAdresse;
            panneauOuvert = filtres.EstActif;
            await ChargerListesAsync();
            await ChargerAsync();

            return;
        }

        // Retour arrière ou lien modifié : l'adresse diffère de l'état de la page.
        if (!depuisAdresse.EstIdentique(filtres))
        {
            filtres = depuisAdresse;
            page = 1;
            await ChargerAsync();
        }
    }

    private async Task ChargerListesAsync()
    {
        try
        {
            modes = await Domaine.ListerModesJeuAsync(new ListerModesJeuRequete());
            mecaniques = await Domaine.ListerMecaniquesAsync(new ListerMecaniquesRequete());
            nomsModes = modes.ToDictionary(m => m.ModeJeuId, m => m.Nom);
            nomsMecaniques = mecaniques.ToDictionary(m => m.MecaniqueId, m => m.Nom);
        }
        catch (Exception exception)
        {
            // Les filtres numériques restent utilisables sans ces deux listes.
            Journal.LogError(exception, "Chargement des modes de jeu et des mécaniques impossible.");
        }
    }

    private async Task ChangerFiltresAsync(FiltresCollection nouveaux)
    {
        filtres = nouveaux;
        page = 1;
        MettreAJourAdresse();
        await ChargerAsync();
    }

    private Task EffacerFiltresAsync()
    {
        return ChangerFiltresAsync(new FiltresCollection());
    }

    private void MettreAJourAdresse()
    {
        var parametres = filtres.VersParametres();
        var valeurs = new Dictionary<string, object?>();

        foreach (var cle in new[]
        {
            FiltresCollection.CleJoueurs, FiltresCollection.CleOptimal, FiltresCollection.CleDuree, FiltresCollection.CleNote,
            FiltresCollection.ClePartiesMin, FiltresCollection.ClePartiesMax, FiltresCollection.CleMode, FiltresCollection.CleMecaniques,
        })
        {
            valeurs[cle] = parametres.GetValueOrDefault(cle);
        }

        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(valeurs), replace: true);
    }

    private async Task ChargerAsync()
    {
        try
        {
            var reponse = await Domaine.ListerCollectionAsync(new ListerCollectionRequete(
                string.IsNullOrWhiteSpace(recherche) ? null : recherche.Trim(), page, TaillePage, filtres.VersContrat()));

            // Dernière page vidée par un retrait : on recule d'une page plutôt que d'afficher du vide.
            if (reponse.Items.Count == 0 && page > 1)
            {
                page--;
                await ChargerAsync();
                return;
            }

            items = reponse.Items;
            total = reponse.Total;
            echec = false;
        }
        catch (Exception exception)
        {
            Journal.LogError(exception, "Chargement de la collection impossible.");
            echec = true;
        }
        finally
        {
            chargementInitial = false;
        }
    }

    private async Task SurChangementRechercheAsync(string? valeur)
    {
        recherche = valeur;
        page = 1;
        await ChargerAsync();
    }

    private async Task ChangerPageAsync(int nouvellePage)
    {
        page = nouvellePage;
        await ChargerAsync();
    }

    private async Task OuvrirAjoutAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialogue = await DialogService.ShowAsync<DialogueAjoutJeu>("Ajouter un jeu", options);
        var resultat = await dialogue.Result;

        if (resultat is { Canceled: false, Data: ItemCollectionDto item })
        {
            Snackbar.Add($"« {item.Nom} » a été ajouté à votre collection.", Severity.Success);
            await ChargerAsync();
        }
    }

    private async Task ModifierAsync(ItemCollectionDto item)
    {
        var parametres = new DialogParameters<DialogueModificationPossession> { { d => d.Item, item } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialogue = await DialogService.ShowAsync<DialogueModificationPossession>(item.Nom, parametres, options);
        var resultat = await dialogue.Result;

        if (resultat is { Canceled: false })
        {
            Snackbar.Add("Les modifications ont été enregistrées.", Severity.Success);
            await ChargerAsync();
        }
    }

    private async Task RetirerAsync(ItemCollectionDto item)
    {
        var confirme = await DialogService.ShowMessageBoxAsync(
            title: "Retirer ce jeu ?",
            message: $"« {item.Nom} » sera retiré de votre collection, avec votre note et votre commentaire. Le jeu reste dans le catalogue.",
            yesText: "Retirer",
            cancelText: "Annuler");

        if (confirme != true)
        {
            return;
        }

        try
        {
            var reponse = await Domaine.RetirerJeuAsync(new RetirerJeuRequete(item.PossessionId));

            if (reponse.Statut == StatutRetrait.Retire)
            {
                Snackbar.Add($"« {item.Nom} » a été retiré de votre collection.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Ce jeu ne faisait déjà plus partie de votre collection.", Severity.Info);
            }

            await ChargerAsync();
        }
        catch (Exception exception)
        {
            Journal.LogError(exception, "Retrait de la possession {PossessionId} impossible.", item.PossessionId);
            Snackbar.Add("Le jeu n'a pas pu être retiré. Réessayez dans un instant.", Severity.Error);
        }
    }
}
