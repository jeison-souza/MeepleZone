@page "/erreur"
@using System.Diagnostics
@inject IWebHostEnvironment Environment

<PageTitle>MeepleZone - Erreur</PageTitle>

<PageErreur Code="500"
            Pret="Pret"
            Image="@Scenario.Image"
            Alt="@Scenario.Alt"
            Titre="@Scenario.Titre"
            Phrase="@Scenario.Phrase"
            Bouton="@Scenario.Bouton"
            Legende="@Scenario.Legende">
    @if (ShowRequestId)
    {
        <p class="mz-erreur-info">
            <strong>Identifiant de la demande :</strong> <code>@RequestId</code>
        </p>
    }

    @* Bloc de débogage : seulement en développement, et masquable avec ?debogage=0 (ou =false) pour voir
       la page comme en production. *@
    @if (Environment.IsDevelopment() && !MasquerDebogage)
    {
        <details class="mz-erreur-info">
            <summary>Mode développement</summary>
            <p>
                Le passage à l'environnement <strong>Development</strong> affiche des renseignements plus détaillés sur l'erreur survenue.
                Pour voir un scénario précis, ajouter <code>?cenario=1</code> à <code>?cenario=@Illustrations.Length</code> à l'adresse;
                pour masquer ce bloc, ajouter <code>?debogage=0</code>.
            </p>
            <p>
                <strong>L'environnement Development ne devrait pas être activé sur une application déployée.</strong>
                Il peut afficher à des personnes utilisatrices des renseignements sensibles tirés des exceptions.
                Pour le débogage local, activer l'environnement <strong>Development</strong> en réglant la variable d'environnement <strong>ASPNETCORE_ENVIRONMENT</strong> à <strong>Development</strong>,
                puis redémarrer l'application.
            </p>
        </details>
    }
</PageErreur>

@code{
    private sealed record Illustration(string Image, string Alt, string Titre, string Phrase, string Bouton, string? Legende = null);

    // Chaque illustration a ses propres textes : le dessin, le titre et la phrase racontent la même histoire.
    private static readonly Illustration[] Illustrations =
    [
        new("images/500-etagere-partida.svg",
            "Une étagère de jeux cassée en deux, des boîtes et des meeples éparpillés par terre, et un meeple affolé.",
            "Échec critique !",
            "L'étagère a raté son jet de sauvegarde. Les pièces sont en train d'être ramassées.",
            "Retour à l'accueil"),
        new("images/500-meeple-buraco.svg",
            "Un meeple sort d'un trou dans le sol, les yeux au ciel, une fiche débranchée dans la main.",
            "Oups, c'est débranché !",
            "Rassurez-vous, ce n'est pas vous : un problème est survenu de notre côté. Le meeple cherche la prise.",
            "Retour à l'accueil",
            "Uh oh!"),
        new("images/500-meeple-fio-braco.svg",
            "Un meeple aux yeux croisés, enroulé dans un fil qui lui fait un tour autour du corps, puis du bras.",
            "Ça s'est tout emmêlé !",
            "Un problème est survenu de notre côté : un fil s'est emmêlé. Il faut démêler tout ça.",
            "Retour à l'accueil",
            "Oh no!"),
    ];

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>En développement seulement : <c>?cenario=2</c> montre le deuxième scénario.</summary>
    [SupplyParameterFromQuery(Name = "cenario")]
    public int? CenarioDemande { get; set; }

    /// <summary>En développement seulement : <c>?debogage=0</c> (ou <c>=false</c>) masque le bloc de débogage.</summary>
    [SupplyParameterFromQuery(Name = "debogage")]
    public string? Debogage { get; set; }

    private bool MasquerDebogage => Debogage is not null && (Debogage == "0" || Debogage.Equals("false", StringComparison.OrdinalIgnoreCase));

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    private int _choix = -1;

    private bool Pret => _choix >= 0;

    private Illustration Scenario => Illustrations[Math.Max(_choix, 0)];

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

    // La page est d'abord rendue sur le serveur (prérendu), puis une seconde fois quand la connexion interactive
    // s'ouvre. Tirer au hasard dans ces deux rendus ferait changer l'illustration après le chargement.
    // OnAfterRender ne s'exécute pas pendant le prérendu : le tirage se fait donc une seule fois, côté interactif.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            var demande = Environment.IsDevelopment() && CenarioDemande is >= 1 && CenarioDemande <= Illustrations.Length;
            _choix = demande ? CenarioDemande!.Value - 1 : Random.Shared.Next(Illustrations.Length);
            StateHasChanged();
        }
    }
}
