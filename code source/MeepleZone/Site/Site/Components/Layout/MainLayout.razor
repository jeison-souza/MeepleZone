@inherits LayoutComponentBase
<MudThemeProvider Theme="@MeepleZoneTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@code {
    // Identité visuelle MeepleZone : orange #D67C2F, Galaxie Deep #101026, fond crème, Open Sans.
    MudTheme MeepleZoneTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#D67C2F",
            PrimaryContrastText = "#FFFFFF",
            Secondary = "#101026",
            SecondaryContrastText = "#F4E9D4",
            Background = "#FBF5E9",
            Surface = "#FFFFFF",
            AppbarBackground = "#101026",
            AppbarText = "#F4E9D4",
            DrawerBackground = "#101026",
            DrawerText = "#F4E9D4",
            TextPrimary = "#101026",
            TextSecondary = "#4A4A63"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Open Sans", "Helvetica", "Arial", "sans-serif" }
            }
        }
    };

    // Ouvert par défaut : sur grand écran le menu reste affiché, sur petit écran MudBlazor le ferme tout seul.
    private bool _menuOuvert = true;

    private void BasculerMenu() => _menuOuvert = !_menuOuvert;
}

<MudLayout>
    <MudAppBar Elevation="0" Class="mz-barre">
        @* Le bouton et la marque ne servent que sur petit écran : sur grand écran, le menu latéral reste visible. *@
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="Ouvrir le menu de navigation" Class="d-sm-none" OnClick="BasculerMenu" />
        <a href="/" class="mz-marque d-sm-none" aria-label="MeepleZone, accueil">
            <img src="images/logo-dark.svg" alt="" />
            <span>Meeple<strong>Zone</strong></span>
        </a>
        <MudSpacer />
        <MudLink Href="/a-propos" Color="Color.Inherit" Underline="Underline.Hover">À propos</MudLink>
    </MudAppBar>

    <MudDrawer @bind-Open="_menuOuvert" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Sm"
               ClipMode="DrawerClipMode.Never" Elevation="0" Width="250px" Class="mz-menu-lateral">
        <MudDrawerHeader Class="mz-menu-entete">
            <a href="/" class="mz-marque" aria-label="MeepleZone, accueil">
                <img src="images/logo-dark.svg" alt="" />
                <span>Meeple<strong>Zone</strong></span>
            </a>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="mz-contenu">
        <article class="content px-4">
            @Body
        </article>

        <footer class="mz-footer px-4">
            <a href="/confidentialite">Confidentialité</a>
            <a href="/conditions">Conditions d'utilisation</a>
        </footer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Une erreur inattendue est survenue.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">🗙</span>
</div>
