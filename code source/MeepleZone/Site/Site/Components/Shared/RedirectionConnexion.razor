@inject NavigationManager Navigation

@* Utilisé quand une page protégée est ouverte sans connexion, pendant la navigation interne. À l'ouverture directe
   (premier chargement ou lien), c'est le témoin d'authentification qui redirige, avec la même adresse de retour. *@

@code {
    protected override void OnInitialized()
    {
        var retour = UrlRetour.Valider("/" + Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.NavigateTo($"/connexion-requise?retour={Uri.EscapeDataString(retour)}", forceLoad: true);
    }
}
